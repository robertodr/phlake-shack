+fn configured_server(
+    kind: LanguageServiceKind,
+    project_id: Option<&str>,
+) -> Result<Option<external::ExternalServer>, LanguageServiceError> {
+    let Some(server) = external::configured(kind)? else {
+        return Ok(None);
+    };
+    if kind == LanguageServiceKind::Tinymist {
+        let version = match project_id {
+            Some(id) => {
+                if id.len() > 128 || paths::validate_project_id(id).is_err() {
+                    return Err(LanguageServiceError::new(
+                        LanguageServiceErrorCode::InvalidWorkspace,
+                        "invalid project id",
+                    ));
+                }
+                let meta = crate::project::read_meta(id).map_err(|_| {
+                    LanguageServiceError::new(
+                        LanguageServiceErrorCode::InvalidWorkspace,
+                        "project metadata is invalid or unreadable",
+                    )
+                })?;
+                crate::typst_toolchain::tinymist::project_typst_version(&meta).to_string()
+            }
+            None => crate::typst_toolchain::default_version(),
+        };
+        server.check_typst_version(&version)?;
+    }
+    Ok(Some(server))
+}
