+    #[cfg(unix)]
+    #[test]
+    fn readonly_nested_files_gain_only_owner_write_permission() {
+        use std::os::unix::fs::PermissionsExt;
+
+        let base = tempfile::tempdir().unwrap();
+        let src = base.path().join("src");
+        let dest = base.path().join("project");
+        std::fs::create_dir_all(src.join("nested")).unwrap();
+        std::fs::create_dir_all(&dest).unwrap();
+        for (name, mode) in [("chapter.typ", 0o444), ("script.sh", 0o555)] {
+            let path = src.join("nested").join(name);
+            std::fs::write(&path, "original").unwrap();
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(mode)).unwrap();
+        }
+
+        copy_tree(&src, &dest, 0).unwrap();
+        for (name, mode) in [("chapter.typ", 0o444), ("script.sh", 0o555)] {
+            let copied = dest.join("nested").join(name);
+            assert_eq!(
+                std::fs::metadata(&copied).unwrap().permissions().mode() & 0o777,
+                mode | 0o200
+            );
+            assert_eq!(
+                std::fs::metadata(src.join("nested").join(name))
+                    .unwrap()
+                    .permissions()
+                    .mode()
+                    & 0o777,
+                mode
+            );
+            std::fs::write(copied, "edited").unwrap();
+        }
+    }
