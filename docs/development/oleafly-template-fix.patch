+    #[cfg(unix)]
+    #[test]
+    fn readonly_templates_create_editable_projects() {
+        use std::os::unix::fs::PermissionsExt;
+
+        let base = tempfile::tempdir().unwrap();
+        let src = base.path().join("readonly");
+        let dest = base.path().join("project");
+        std::fs::create_dir_all(&src).unwrap();
+        std::fs::create_dir_all(&dest).unwrap();
+        std::fs::write(
+            src.join("template.json"),
+            serde_json::json!({
+                "id": "readonly", "name": "Read-only template",
+                "main_doc": "main.typ", "engine": "typst"
+            })
+            .to_string(),
+        )
+        .unwrap();
+        let main = src.join("main.typ");
+        std::fs::write(&main, "= Original\n").unwrap();
+        std::fs::set_permissions(&main, std::fs::Permissions::from_mode(0o444)).unwrap();
+
+        instantiate_from(&src, &dest).unwrap();
+        // Research-project creation replaces the copied main with its preview.
+        std::fs::write(dest.join("main.typ"), "= Research project\n").unwrap();
+        assert_eq!(std::fs::read_to_string(&main).unwrap(), "= Original\n");
+        assert_eq!(
+            std::fs::metadata(&main).unwrap().permissions().mode() & 0o777,
+            0o444
+        );
+    }
